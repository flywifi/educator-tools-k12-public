{
  "skill_name": "output-validator",
  "_note": "Declarative cases for tools/validate_outputs.py + tools/validate_document.py. Stdlib-first; no real data.",
  "evals": [
    {
      "kind": "command",
      "name": "governed_artifact_passes",
      "command": "python3 tools/validate_outputs.py --input <records-package.json>",
      "assert": {
        "status": "pass",
        "human_review_required": true
      }
    },
    {
      "name": "missing_human_review_fails",
      "kind": "command",
      "command": "python3 tools/validate_outputs.py --input skills/core/output-validator/evals/fixtures/artifact-human-review-false.json",
      "assert": {
        "status": "fail",
        "exit_code": 1,
        "stdout_contains": [
          "\"rule\": \"human_review_required\""
        ]
      },
      "_note": "Executable since R6 (was filed as `prompt`; tools/validate_outputs.py performs it). human_review_required: false must be a blocking rule_failure."
    },
    {
      "name": "real_pii_blocks",
      "kind": "command",
      "command": "python3 tools/validate_outputs.py --input skills/core/output-validator/evals/fixtures/artifact-ssn-pattern.json",
      "assert": {
        "status": "fail",
        "exit_code": 1,
        "stdout_contains": [
          "\"rule\": \"no_real_pii\""
        ]
      },
      "_note": "Executable since R6 (was filed as `prompt`; tools/validate_outputs.py performs it). An SSN-pattern value anywhere triggers no_real_pii (blocking). The fixture value 000-00-0000 is structurally impossible as a real SSN."
    },
    {
      "kind": "command",
      "name": "valid_pptx_structural_pass",
      "command": "python3 tools/validate_document.py deck.pptx",
      "assert": {
        "kind": "pptx",
        "valid": true
      }
    },
    {
      "kind": "command",
      "name": "truncated_ooxml_detected",
      "_note": "A truncated/partial .pptx is not a valid zip -> blocking.",
      "command": "python3 tools/validate_document.py truncated.pptx",
      "assert": {
        "valid": false,
        "findings_include": "bad_zip"
      }
    },
    {
      "kind": "command",
      "name": "truncated_pdf_detected",
      "command": "python3 tools/validate_document.py truncated.pdf",
      "assert": {
        "valid": false,
        "findings_include": "pdf_missing_eof"
      }
    }
  ]
}
